# APP_URL: The URL where this application is hosted.
APP_URL="https://www.transpetroenergy.org"

# AI Virtual Assistant (PEARL) — Server-Side Configuration Only
# Never expose these variables to client-side code or prefix with VITE_.
# Supported AI_PROVIDER values: "gemini" (default) or "openai"
AI_PROVIDER=gemini
# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=
# Default model for Gemini: gemini-4-hydrogen (or set another supported model for your chosen provider)
AI_MODEL=gemini-4-hydrogen
# Required only if AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional SMTP Configuration for Contact & PEARL Lead Email Delivery
# When configured, enquiries submitted through /api/enquiries and /api/pearl/leads
# are dispatched directly via SMTP. Leave unset if you have not yet connected a mail provider;
# the application will transparently report that SMTP delivery is not configured and offer
# direct email/WhatsApp options.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_RECIPIENT_EMAIL=info.moore@transpetroenergy.org
