# APP_URL: The URL where this application is hosted.
APP_URL="https://www.transpetroenergy.org"

# Optional SMTP Configuration for Contact Enquiry Email Delivery
# When configured, enquiries submitted through /api/enquiries are dispatched directly via SMTP.
# Leave unset if you have not yet connected a mail provider; the application will transparently
# report that SMTP delivery is not configured and offer direct email/WhatsApp options.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_RECIPIENT_EMAIL=info.moore@transpetroenergy.org
